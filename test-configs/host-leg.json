{
  "logging": {
    "level": "INFO",
    "rust_format": "{timestamp} [{level}] [{component}] {target} - {message}"
  },
  "hierarchy": {
    "levels": [
      "site",
      "device"
    ]
  },
  "identity": {
    "site": "host-leg"
  },
  "heartbeat": {
    "enabled": true,
    "intervalSecs": 1,
    "measures": {
      "cpu": true,
      "memory": true
    },
    "destination": "local"
  },
  "metricEmission": {
    "target": "messaging",
    "namespace": "edgecommons",
    "targetConfig": {
      "destination": "local"
    }
  },
  "tags": {
    "site": "host-leg"
  },
  "component": {
    "token": "mtconnect-adapter",
    "global": {
      "agents": [
        {
          "id": "live-agent",
          "url": "http://localhost:5010",
          "streaming": "prefer",
          "heartbeatMs": 3000,
          "pollIntervalMs": 500,
          "requestTimeoutMs": 3000,
          "reconnect": {
            "initialMs": 500,
            "maxMs": 2000
          }
        }
      ],
      "defaults": {
        "pollIntervalMs": 250,
        "publishMode": "on-change"
      },
      "healthThresholds": {
        "staleSignalSecs": 4
      }
    },
    "instances": [
      {
        "id": "cnc-1",
        "adapter": "mtconnect",
        "connection": {
          "agentId": "live-agent",
          "deviceUuid": "MTC-E2E-001"
        },
        "pollIntervalMs": 250,
        "signals": [
          {
            "id": "x-position",
            "name": "X axis actual position",
            "dataItemId": "d1-Xabs",
            "conditionBinding": [
              "d1-travel"
            ],
            "publish": {
              "mode": "on-change",
              "batchMs": 5000
            }
          },
          {
            "id": "availability",
            "name": "Device availability",
            "dataItemId": "d1-avail"
          },
          {
            "id": "execution",
            "name": "Execution state",
            "dataItemId": "d1-exec"
          },
          {
            "id": "x-travel",
            "name": "X axis travel condition",
            "dataItemId": "d1-travel"
          }
        ],
        "writes": {
          "allow": []
        }
      }
    ]
  }
}
